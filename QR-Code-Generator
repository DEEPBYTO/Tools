<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Free QR Code Generator | DEEPBYTO</title>
  <meta name="description" content="Create free QR codes for URLs, text, contact information and more with DEEPBYTO QR Code Generator.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://deepbyto.github.io/tools/qr-code-generator.html">

  <!-- QR Code Library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #000;
      --card: #0d0d0d;
      --card-2: #111;
      --border: rgba(255,255,255,0.12);
      --border-hover: rgba(255,255,255,0.3);
      --text: #fff;
      --muted: #999;
      --input: #090909;
      --button: #fff;
      --button-text: #000;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 50% 0%, rgba(255,255,255,0.07), transparent 35%),
        #000;
      color: var(--text);
      font-family: Inter, Arial, Helvetica, sans-serif;
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1100px, calc(100% - 32px));
      margin: auto;
    }

    /* NAVBAR */

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid var(--border);
      background: rgba(0,0,0,0.82);
      backdrop-filter: blur(18px);
    }

    .nav {
      height: 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 2px;
    }

    .back {
      color: var(--muted);
      font-size: 14px;
      transition: .2s;
    }

    .back:hover {
      color: white;
    }

    /* HERO */

    .hero {
      text-align: center;
      padding: 80px 0 35px;
    }

    .badge {
      display: inline-block;
      padding: 6px 13px;
      border: 1px solid var(--border);
      border-radius: 30px;
      color: #bbb;
      font-size: 12px;
      margin-bottom: 18px;
      letter-spacing: .5px;
    }

    h1 {
      font-size: clamp(36px, 7vw, 68px);
      line-height: 1.05;
      letter-spacing: -2px;
      margin-bottom: 18px;
    }

    .hero p {
      max-width: 650px;
      margin: auto;
      color: var(--muted);
      font-size: 17px;
    }

    /* TOOL */

    .tool {
      max-width: 900px;
      margin: 35px auto 90px;
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: 22px;
    }

    .panel {
      background: linear-gradient(145deg, #111, #080808);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      box-shadow: 0 20px 70px rgba(0,0,0,.4);
    }

    .panel h2 {
      font-size: 20px;
      margin-bottom: 20px;
    }

    label {
      display: block;
      font-size: 13px;
      color: #bbb;
      margin-bottom: 8px;
    }

    textarea {
      width: 100%;
      min-height: 180px;
      resize: vertical;
      background: var(--input);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 15px;
      color: white;
      outline: none;
      font: inherit;
      font-size: 15px;
      transition: .2s;
    }

    textarea:focus {
      border-color: var(--border-hover);
      box-shadow: 0 0 0 3px rgba(255,255,255,.04);
    }

    .controls {
      margin-top: 20px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    select,
    input[type="color"] {
      width: 100%;
      height: 45px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #080808;
      color: white;
      padding: 0 12px;
    }

    input[type="color"] {
      padding: 5px;
      cursor: pointer;
    }

    .field {
      min-width: 0;
    }

    .buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 20px;
    }

    button {
      border: 0;
      cursor: pointer;
      border-radius: 10px;
      padding: 12px 18px;
      font-weight: 700;
      font-size: 14px;
      transition: .2s;
    }

    .primary {
      background: white;
      color: black;
      flex: 1;
    }

    .primary:hover {
      background: #ddd;
      transform: translateY(-1px);
    }

    .secondary {
      background: transparent;
      color: white;
      border: 1px solid var(--border);
    }

    .secondary:hover {
      border-color: white;
    }

    /* QR */

    .qr-panel {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .qr-wrapper {
      width: 260px;
      height: 260px;
      background: white;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 15px;
      margin: 10px auto 20px;
    }

    #qrcode {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #qrcode img,
    #qrcode canvas {
      max-width: 100%;
      height: auto;
    }

    .qr-placeholder {
      color: #777;
      font-size: 14px;
    }

    .download-buttons {
      width: 100%;
      display: flex;
      gap: 10px;
    }

    .download-buttons button {
      flex: 1;
    }

    .status {
      min-height: 22px;
      margin-top: 12px;
      color: #999;
      font-size: 13px;
    }

    /* INFO */

    .info {
      max-width: 900px;
      margin: 0 auto 90px;
    }

    .info h2 {
      text-align: center;
      margin-bottom: 35px;
      font-size: 30px;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }

    .feature {
      padding: 22px;
      border: 1px solid var(--border);
      border-radius: 15px;
      background: rgba(255,255,255,.02);
    }

    .feature h3 {
      font-size: 16px;
      margin-bottom: 8px;
    }

    .feature p {
      color: var(--muted);
      font-size: 14px;
    }

    /* FOOTER */

    footer {
      border-top: 1px solid var(--border);
      padding: 30px 0;
      text-align: center;
      color: #777;
      font-size: 13px;
    }

    footer a {
      color: #aaa;
    }

    footer a:hover {
      color: white;
    }

    /* MOBILE */

    @media (max-width: 800px) {
      .tool {
        grid-template-columns: 1fr;
      }

      .qr-panel {
        order: -1;
      }

      .features {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 500px) {
      .hero {
        padding-top: 55px;
      }

      .hero p {
        font-size: 15px;
      }

      .panel {
        padding: 20px;
      }

      .controls {
        grid-template-columns: 1fr;
      }

      .qr-wrapper {
        width: 230px;
        height: 230px;
      }

      .nav {
        height: 62px;
      }

      h1 {
        letter-spacing: -1px;
      }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <header>
    <div class="container nav">
      <a href="https://deepbyto.github.io/" class="brand">
        DEEPBYTO
      </a>

      <a href="https://deepbyto.github.io/" class="back">
        ← Back to DEEPBYTO
      </a>
    </div>
  </header>


  <!-- HERO -->
  <main>

    <section class="hero">
      <div class="container">

        <div class="badge">
          FREE ONLINE TOOL
        </div>

        <h1>QR Code Generator</h1>

        <p>
          Create free QR codes for websites, text, contact information,
          WhatsApp links and more.
        </p>

      </div>
    </section>


    <!-- TOOL -->
    <section class="container">

      <div class="tool">

        <!-- INPUT PANEL -->
        <div class="panel">

          <h2>Create Your QR Code</h2>

          <label for="text">
            Enter text or URL
          </label>

          <textarea
            id="text"
            placeholder="Example: https://deepbyto.github.io/"
          >https://deepbyto.github.io/</textarea>


          <div class="controls">

            <div class="field">
              <label for="size">
                QR Size
              </label>

              <select id="size">
                <option value="200">200 × 200</option>
                <option value="300" selected>300 × 300</option>
                <option value="400">400 × 400</option>
                <option value="500">500 × 500</option>
              </select>
            </div>


            <div class="field">
              <label for="foreground">
                QR Color
              </label>

              <input
                type="color"
                id="foreground"
                value="#000000"
              >
            </div>


            <div class="field">
              <label for="background">
                Background
              </label>

              <input
                type="color"
                id="background"
                value="#ffffff"
              >
            </div>

          </div>


          <div class="buttons">

            <button
              class="primary"
              onclick="generateQR()"
            >
              Generate QR Code
            </button>

            <button
              class="secondary"
              onclick="clearTool()"
            >
              Clear
            </button>

          </div>

        </div>


        <!-- QR PANEL -->
        <div class="panel qr-panel">

          <h2>Your QR Code</h2>

          <div class="qr-wrapper">

            <div id="qrcode">

              <div class="qr-placeholder">
                Your QR code will appear here
              </div>

            </div>

          </div>


          <div class="download-buttons">

            <button
              class="secondary"
              onclick="downloadPNG()"
            >
              Download PNG
            </button>

            <button
              class="secondary"
              onclick="downloadSVG()"
            >
              Download SVG
            </button>

          </div>

          <div
            id="status"
            class="status"
          ></div>

        </div>

      </div>

    </section>


    <!-- FEATURES -->
    <section class="container info">

      <h2>What Can You Create?</h2>

      <div class="features">

        <div class="feature">
          <h3>Website QR Codes</h3>
          <p>
            Turn any website URL into a scannable QR code.
          </p>
        </div>

        <div class="feature">
          <h3>WhatsApp Links</h3>
          <p>
            Create QR codes that open a WhatsApp conversation.
          </p>
        </div>

        <div class="feature">
          <h3>Text & Information</h3>
          <p>
            Convert plain text and useful information into QR codes.
          </p>
        </div>

        <div class="feature">
          <h3>Business Use</h3>
          <p>
            Use QR codes for menus, contact details, products and promotions.
          </p>
        </div>

        <div class="feature">
          <h3>Custom Colors</h3>
          <p>
            Choose your QR code and background colors.
          </p>
        </div>

        <div class="feature">
          <h3>Download</h3>
          <p>
            Download your generated QR code as a PNG or SVG file.
          </p>
        </div>

      </div>

    </section>

  </main>


  <!-- FOOTER -->
  <footer>

    <div class="container">

      <p>
        © 2026
        <a href="https://deepbyto.github.io/">
          DEEPBYTO
        </a>
        · Free QR Code Generator
      </p>

    </div>

  </footer>


  <script>

    let currentQR = null;


    /*
      GENERATE QR CODE
    */

    function generateQR() {

      const text =
        document.getElementById("text").value.trim();

      const size =
        parseInt(document.getElementById("size").value);

      const foreground =
        document.getElementById("foreground").value;

      const background =
        document.getElementById("background").value;

      const qrContainer =
        document.getElementById("qrcode");

      const status =
        document.getElementById("status");


      if (!text) {

        status.textContent =
          "Please enter some text or a URL.";

        return;
      }


      qrContainer.innerHTML = "";

      try {

        currentQR = new QRCode(qrContainer, {

          text: text,

          width: size,

          height: size,

          colorDark: foreground,

          colorLight: background,

          correctLevel:
            QRCode.CorrectLevel.H

        });


        status.textContent =
          "QR code generated successfully.";

      }

      catch (error) {

        console.error(error);

        status.textContent =
          "Could not generate the QR code.";

      }

    }


    /*
      CLEAR
    */

    function clearTool() {

      document.getElementById("text").value = "";

      document.getElementById("qrcode").innerHTML =
        '<div class="qr-placeholder">Your QR code will appear here</div>';

      document.getElementById("status").textContent = "";

      currentQR = null;

    }


    /*
      DOWNLOAD PNG
    */

    function downloadPNG() {

      const qr =
        document.querySelector("#qrcode canvas");

      if (!qr) {

        document.getElementById("status").textContent =
          "Generate a QR code first.";

        return;
      }


      const link =
        document.createElement("a");

      link.download =
        "deepbyto-qr-code.png";

      link.href =
        qr.toDataURL("image/png");

      link.click();

    }


    /*
      DOWNLOAD SVG

      qrcodejs generates canvas/image rather than SVG.
      We create an SVG containing the generated QR image.
    */

    function downloadSVG() {

      const qrCanvas =
        document.querySelector("#qrcode canvas");

      if (!qrCanvas) {

        document.getElementById("status").textContent =
          "Generate a QR code first.";

        return;
      }


      const size =
        qrCanvas.width;

      const image =
        qrCanvas.toDataURL("image/png");


      const svg =
`<svg xmlns="http://www.w3.org/2000/svg"
width="${size}"
height="${size}"
viewBox="0 0 ${size} ${size}">
<image
width="${size}"
height="${size}"
href="${image}"
/>
</svg>`;


      const blob =
        new Blob(
          [svg],
          { type: "image/svg+xml" }
        );


      const url =
        URL.createObjectURL(blob);


      const link =
        document.createElement("a");

      link.href = url;

      link.download =
        "deepbyto-qr-code.svg";

      link.click();


      URL.revokeObjectURL(url);

    }


    /*
      GENERATE DEFAULT QR ON PAGE LOAD
    */

    window.addEventListener(
      "load",
      generateQR
    );

  </script>

</body>
</html>
